# ==========================================================
# SwipeHire – Server Environment Variables
# Copy this file to server/.env and fill in your values
# ==========================================================

# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ──────────────────────────────────────────
# How to get:
#   1. Go to https://cloud.mongodb.com
#   2. Create a free M0 cluster
#   3. Click "Connect" → "Connect your application"
#   4. Copy the URI and replace <username>, <password>, <dbname>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/swipehire?retryWrites=true&w=majority

# ── JWT Authentication ──────────────────────────────────────
# Use any long random string (min 32 chars). Keep this secret!
JWT_SECRET=change_this_to_a_long_random_secret_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── Google Gemini AI ────────────────────────────────────────
# How to get:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API Key" (free tier available)
#   3. Paste the key below
# If left empty or unset, the app uses smart mock AI responses automatically.
GEMINI_API_KEY=

# ── Cloudinary (Resume / Avatar Uploads) ───────────────────
# How to get:
#   1. Go to https://cloudinary.com and create a free account
#   2. Find your Cloud Name, API Key, and API Secret on the Dashboard
# If left empty, file upload features will use base64 local storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend URL (for CORS) ─────────────────────────────────
# In development: http://localhost:5173
# In production:  https://your-swipehire-app.vercel.app
CLIENT_URL=http://localhost:5173
